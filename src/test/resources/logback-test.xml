<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console Appender for standard out / terminal execution visibility -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- SiftingAppender routes log messages into different files dynamically -->
    <appender name="SIFT" class="ch.qos.logback.classic.sift.SiftingAppender">

        <!-- MDC-based discriminator -->
        <discriminator class="ch.qos.logback.classic.sift.MDCBasedDiscriminator">
            <key>testId</key>
            <!-- Fallback folder/file if no testId is present in MDC -->
            <defaultValue>common-context</defaultValue>
        </discriminator>

        <sift>
            <!-- A separate FileAppender is created per unique testId -->
            <appender name="FILE-${testId}" class="ch.qos.logback.core.FileAppender">
                <!-- Saves the output to /tmp/test-logs/{testId}.log -->
                <file>/tmp/test-logs/${testId}.log</file>
                <!-- Set to false if you want a clean log file for every execution -->
                <append>false</append>
                <encoder>
                    <pattern>%msg</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <!-- Root Logger Configuration -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="SIFT" />
    </root>

</configuration>
